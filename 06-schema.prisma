// ============================================================================
//  Asistente IA de Pedidos — schema.prisma
//  Ubicación en el repo: backend/prisma/schema.prisma
//  Ejecutar:  npx prisma migrate dev --name init
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ────────────────────────────── ENUMS ──────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN_NEGOCIO
  ASESOR_VENTAS
}

enum ConversationStatus {
  ACTIVE
  HANDED_OFF
  CLOSED
}

enum MessageRole {
  CUSTOMER
  ASSISTANT
  SYSTEM // notificaciones automáticas de cambio de estado
  ADVISOR // mensajes del asesor humano tras un handoff
}

enum CartStatus {
  DRAFT
  CONFIRMED
  ABANDONED
}

/// Estados de la orden. PENDING_REVIEW y PENDING_PAYMENT quedaron FUSIONADOS
/// en PENDING_PAYMENT: el asesor revisa y confirma el pago en el mismo paso.
enum OrderStatus {
  PENDING_PAYMENT // creada por el asistente, esperando revisión + pago
  PAID // pago verificado por el asesor -> descuenta stock real
  PREPARING // alistamiento
  SHIPPED
  DELIVERED
  RELEASED // liberada por no pago (automática o manual) -> devuelve reserva
  CANCELLED // cancelada (incluye reapertura por edición del cliente antes de pagar)
}

enum OrderType {
  ORIGINAL
  AMENDMENT // orden de excedente generada al editar una orden ya pagada
}

enum InventoryMovementType {
  RESERVE // carrito confirmado -> stockReserved +
  RELEASE // liberación/cancelación -> stockReserved -
  CONSUME // pago confirmado -> stockOnHand - y stockReserved -
  RESTOCK // devolución o reingreso
  MANUAL_ADJUST // ajuste del administrador
}

// ────────────────────────────── NEGOCIO ──────────────────────────────

model Business {
  id           String   @id @default(cuid())
  name         String
  advisorName  String
  contactPhone String
  timezone     String   @default("America/Bogota")
  currency     String   @default("COP")
  /// Días adicionales que el cliente puede pedir de plazo (por defecto 1, una sola vez)
  maxDeadlineExtensionDays Int @default(1)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users              User[]
  customers          Customer[]
  products           Product[]
  conversations      Conversation[]
  orders             Order[]
  otpVerifications   OtpVerification[]
  customerSessions   CustomerSession[]
  inventoryMovements InventoryMovement[]
  orderSequence      OrderSequence?
}

/// Secuencia de numeración legible de órdenes por negocio (PED-000001)
model OrderSequence {
  businessId String   @id
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lastNumber Int      @default(0)
}

// ────────────────────────────── USUARIOS INTERNOS ──────────────────────────────

model User {
  id               String    @id @default(cuid())
  businessId       String
  business         Business  @relation(fields: [businessId], references: [id])
  name             String
  email            String    @unique
  passwordHash     String
  /// Un usuario tiene EXACTAMENTE un rol. No existe mezcla de roles.
  role             Role
  twoFactorSecret  String? // cifrado con ENCRYPTION_KEY (AES-256-GCM)
  twoFactorEnabled Boolean   @default(false)
  active           Boolean   @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  passwordResets PasswordReset[]

  @@index([businessId, role])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ────────────────────────────── CLIENTES ──────────────────────────────

model Customer {
  id             String    @id @default(cuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id])
  phone          String
  name           String?
  address        String?
  /// Ley 1581/2012 — autorización de tratamiento de datos
  dataConsent    Boolean   @default(false)
  consentAt      DateTime?
  consentVersion String? // versión del aviso de privacidad aceptado
  deletedAt      DateTime? // soft delete para derecho de supresión
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversations Conversation[]
  orders        Order[]
  sessions      CustomerSession[]

  @@unique([businessId, phone])
  @@index([businessId, createdAt])
}

/// Sesión de invitado del chat público. Se crea ANTES de conocer al cliente y
/// solo queda ligada a un Customer después de verificar el OTP.
/// Es lo que impide que alguien consulte datos de un teléfono ajeno.
model CustomerSession {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id])
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  phone       String?
  tokenHash   String    @unique // token firmado guardado en cookie httpOnly
  otpVerified Boolean   @default(false)
  verifiedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  conversations Conversation[]

  @@index([businessId, phone])
}

model OtpVerification {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id])
  phone       String
  codeHash    String // NUNCA en texto plano
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  verifiedAt  DateTime?
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([businessId, phone, createdAt])
}

// ────────────────────────────── CATÁLOGO E INVENTARIO ──────────────────────────────

model Product {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  sku         String?
  name        String
  description String? // descripción simple, sin propiedades de salud
  price       Decimal  @db.Decimal(12, 2)
  active      Boolean  @default(true)
  /// stock disponible para vender = stockOnHand - stockReserved
  stockOnHand   Int @default(0)
  stockReserved Int @default(0)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
  movements  InventoryMovement[]
  adjustments OrderAdjustment[]

  @@unique([businessId, sku])
  @@index([businessId, active])
}

/// Bitácora de TODO movimiento de inventario. Permite auditar y reconstruir
/// el stock sin depender solo del valor actual de Product.
model InventoryMovement {
  id          String                @id @default(cuid())
  businessId  String
  business    Business              @relation(fields: [businessId], references: [id])
  productId   String
  product     Product               @relation(fields: [productId], references: [id])
  type        InventoryMovementType
  quantity    Int // siempre positivo; el tipo define el signo lógico
  orderId     String?
  order       Order?                @relation(fields: [orderId], references: [id])
  performedBy String // userId, "SYSTEM" o "ASSISTANT"
  note        String?
  createdAt   DateTime              @default(now())

  @@index([businessId, productId, createdAt])
}

// ────────────────────────────── CONVERSACIÓN (≠ PEDIDO) ──────────────────────────────

model Conversation {
  id           String             @id @default(cuid())
  businessId   String
  business     Business           @relation(fields: [businessId], references: [id])
  customerId   String?
  customer     Customer?          @relation(fields: [customerId], references: [id])
  sessionId    String?
  session      CustomerSession?   @relation(fields: [sessionId], references: [id])
  status       ConversationStatus @default(ACTIVE)
  handoffReason String?
  handedOffAt  DateTime?
  closedAt     DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  messages Message[]
  cart     Cart?
  orders   Order[]

  @@index([businessId, status])
  @@index([customerId, createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  toolCalls      Json? // trazabilidad: qué tools se llamaron en este turno
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ────────────────────────────── CARRITO (entidad propia) ──────────────────────────────

model Cart {
  id             String       @id @default(cuid())
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status         CartStatus   @default(DRAFT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items CartItem[]
  order Order?
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2) // snapshot del precio al agregar

  /// Impide físicamente el doble ingreso del mismo producto en un carrito
  @@unique([cartId, productId])
}

// ────────────────────────────── ORDEN DE VENTA ──────────────────────────────

model Order {
  id             String        @id @default(cuid())
  /// Número legible por humanos, único por negocio: PED-000001
  orderNumber    String
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id])
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  cartId         String?       @unique
  cart           Cart?         @relation(fields: [cartId], references: [id])

  type   OrderType   @default(ORIGINAL)
  status OrderStatus @default(PENDING_PAYMENT)

  subtotal Decimal @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)
  currency String  @default("COP")

  /// 23:59:59 del día del pedido en la zona horaria del negocio.
  /// Extensible UNA sola vez, +1 día, solo a solicitud del cliente.
  paymentDeadline   DateTime
  deadlineExtended  Boolean   @default(false)
  extensionAskedAt  DateTime?

  paidAt        DateTime?
  paidConfirmedBy String? // userId del asesor que verificó el pago
  shippedAt     DateTime?
  deliveredAt   DateTime?
  releasedAt    DateTime?

  /// Enlaza una orden de excedente (AMENDMENT) con la orden original ya pagada
  parentOrderId String?
  parentOrder   Order?  @relation("OrderAmendments", fields: [parentOrderId], references: [id])
  amendments    Order[] @relation("OrderAmendments")

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusEvent[]
  adjustments   OrderAdjustment[]
  movements     InventoryMovement[]

  @@unique([businessId, orderNumber])
  @@index([businessId, status, createdAt])
  @@index([customerId, createdAt])
  @@index([status, paymentDeadline]) // usado por el job de liberación
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  @@unique([orderId, productId])
}

model OrderStatusEvent {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  changedBy  String // userId del asesor o "SYSTEM"
  changedByRole Role?
  reason     String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

/// Edición en sitio de una orden YA PAGADA, hecha por el asesor de ventas.
/// Registra el delta de cada línea para poder corregir inventario y auditar.
model OrderAdjustment {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  previousQty Int
  newQty      Int
  deltaQty    Int // newQty - previousQty
  reason      String
  changedBy   String // userId del asesor
  createdAt   DateTime @default(now())

  @@index([orderId, createdAt])
}
